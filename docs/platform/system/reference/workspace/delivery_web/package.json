{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:all": "E2E_ALL_BROWSERS=true playwright test",
    "test:e2e:coverage": "E2E_COVERAGE=true playwright test && node scripts/check-e2e-coverage.mjs",
    "test:e2e:live": "bash scripts/run-live-e2e.sh",
    "test:actions": "node scripts/verify-action-contracts.mjs",
    "handbook:generate": "node scripts/generate-system-handbook.mjs --workspace-root .. --write",
    "handbook:check": "node scripts/generate-system-handbook.mjs --workspace-root .. --check",
    "handbook:docs:generate": "node scripts/generate-system-docs-portal.mjs --workspace-root .. --write",
    "handbook:docs:check": "node scripts/generate-system-docs-portal.mjs --workspace-root .. --check",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:actions && npm run handbook:check && npm run handbook:docs:check && npm run build",
    "verify:ci": "npm run lint && npm run typecheck && npm test && npm run test:actions && npm run build"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
