# Copy to .env locally and replace every placeholder outside source control.
DB_PASSWORD_FILE=./.secrets/db-password
INTERNAL_SECRET_FILE=./.secrets/internal-secret
GRAFANA_ADMIN_PASSWORD=<generate-a-long-random-grafana-password>
JWT_PRIVATE_KEY_FILE=./.secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./.secrets/jwt-public.pem

# Optional provider credentials. Leave unset unless the corresponding feature is
# explicitly enabled and approved for the environment.
PAYMENT_PROCESSING_ENABLED=false
PAYOUT_PROCESSING_ENABLED=false
PAYOUT_PROVIDER=PAYOS
GOOGLE_OAUTH_CLIENT_IDS=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Auth security email provider (approved production transport: AWS SES SMTP).
SMTP_HOST=email-smtp.<region>.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=<ses-smtp-username>
SMTP_PASSWORD=<ses-smtp-password>
SMTP_AUTH=true
SMTP_STARTTLS=true
SECURITY_EMAIL_FROM=no-reply@example.com
PASSWORD_RESET_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email

# Voucher/flash-sale checkout rollout. Keep every switch false until the
# Task 21 concurrency, compensation, contract and reconciliation gates pass.
ORDER_VOUCHER_CHECKOUT_ENABLED=false
ORDER_FLASHSALE_CHECKOUT_ENABLED=false
ORDER_SERVICEABILITY_ENFORCEMENT_ENABLED=false
ORDER_ETA_WINDOW_ENABLED=false
ORDER_INVENTORY_RESERVATION_ENABLED=false
RESTAURANT_SERVICEABILITY_ENABLED=false
RESTAURANT_INVENTORY_ENABLED=false
RESTAURANT_INVENTORY_CONSUMER_ENABLED=false
NOTIFICATION_PREFERENCES_ENABLED=false
PROMOTION_CHECKOUT_ENABLED=false
PROMOTION_OUTBOX_RELAY_ENABLED=false
PROMOTION_MERCHANT_CREATE_API_ENABLED=false
FLASHSALE_CHECKOUT_ENABLED=false
FLASHSALE_OUTBOX_RELAY_ENABLED=false
FLASHSALE_MERCHANT_REGISTRATION_ENABLED=false

# Delivery proof / post-pickup exception rollout. Keep every switch false until
# a private signed object-storage adapter and the Settlement review bridge are
# configured and rehearsed together.
DELIVERY_POD_ENABLED=false
DELIVERY_POD_STORAGE_PROVIDER=
DELIVERY_EXCEPTION_ENABLED=false
SETTLEMENT_DELIVERY_EXCEPTION_PROCESSING_ENABLED=false
