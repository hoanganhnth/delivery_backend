# Copy to .env locally and replace every placeholder outside source control.
DB_PASSWORD_FILE=./.secrets/db-password
INTERNAL_SECRET_FILE=./.secrets/internal-secret
GRAFANA_ADMIN_PASSWORD=<generate-a-long-random-grafana-password>
JWT_PRIVATE_KEY_FILE=./.secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./.secrets/jwt-public.pem

# Optional provider credentials. Leave unset unless the corresponding feature is
# explicitly enabled and approved for the environment.
GOOGLE_OAUTH_CLIENT_IDS=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
