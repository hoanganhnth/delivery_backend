<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.delivery</groupId>
        <artifactId>delivery-build-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../platform/delivery-build-parent/pom.xml</relativePath>
    </parent>
    <groupId>com.delivery</groupId>
    <artifactId>notification-infrastructure</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>notification-infrastructure</name>
    <description>Notification HTTP, Kafka, JPA, Redis and Firebase adapters, migrations and Spring composition.</description>
    <dependencies>
		<dependency><groupId>com.delivery</groupId><artifactId>notification-application</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>kafka-starter</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>order-contracts</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>delivery-contracts</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>identity-contracts</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>runtime-platform-starter</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>observability-starter</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<dependency><groupId>com.delivery</groupId><artifactId>auth-resource-server-starter</artifactId><version>1.0.0-SNAPSHOT</version></dependency>
		<!-- Spring Boot Starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Redis -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Kafka -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- Database -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Firebase Admin SDK -->
		<dependency>
			<groupId>com.google.firebase</groupId>
			<artifactId>firebase-admin</artifactId>
			<version>9.2.0</version>
		</dependency>

		<!-- Utilities -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- JSON Processing -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<dependency><groupId>io.micrometer</groupId><artifactId>micrometer-tracing-bridge-otel</artifactId></dependency>
		<dependency><groupId>io.opentelemetry</groupId><artifactId>opentelemetry-exporter-otlp</artifactId></dependency>
    </dependencies>
</project>
