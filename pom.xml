<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.delivery</groupId>
    <artifactId>deliveryvn</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>platform/delivery-platform-bom</module>
        <module>platform/delivery-build-parent</module>
        <module>platform/kafka-starter</module>
        <module>platform/event-test-support</module>
        <module>observability-starter</module>
        <module>kafka-operations-tool</module>
        <module>runtime-platform-starter</module>
        <module>platform/platform-http-blocking</module>
        <module>identity-contracts</module>
        <module>search-contracts</module>
        <module>routing-contracts</module>
        <module>delivery-contracts</module>
        <module>order-contracts</module>
        <module>clients/identity-client</module>
        <module>clients/routing-client</module>
        <module>restaurant/domain</module>
        <module>restaurant/application-api</module>
        <module>restaurant/application</module>
        <module>restaurant/infrastructure</module>
        <module>tracking/domain</module>
        <module>tracking/application-api</module>
        <module>tracking/application</module>
        <module>tracking/infrastructure</module>
        <module>settlement/domain</module>
        <module>settlement/application-api</module>
        <module>settlement/application</module>
        <module>settlement/infrastructure</module>
        <module>modules/delivery/delivery-domain</module>
        <module>modules/delivery/delivery-application-api</module>
        <module>modules/delivery/delivery-application</module>
        <module>modules/delivery/delivery-infrastructure</module>
        <module>match/domain</module>
        <module>match/application-api</module>
        <module>match/application</module>
        <module>match/infrastructure</module>
        <module>auth-resource-server-starter</module>
        <module>discovery-server</module>
        <module>config-server</module>
        <module>auth</module>
        <module>user</module>
        <module>api-gateway</module>
        <module>web-bff</module>
        <module>delivery-service</module>
        <module>notification-service</module>
        <module>order-service</module>
        <module>restaurant/boot</module>
        <module>shipper</module>
        <module>search-service</module>
        <module>saga-orchestrator-service</module>
        <module>tracking/boot</module>
        <module>match/boot</module>
        <module>routing</module>
        <module>livestream-service</module>
        <module>settlement/boot</module>
        <module>flashsale-service</module>
        <module>analytics-service</module>
        <module>promotion-service</module>
        <module>simulator-service</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
