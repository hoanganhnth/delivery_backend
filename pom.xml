        <module>modules/user/user-infrastructure</module>
        <module>modules/delivery/delivery-domain</module>
        <module>modules/delivery/delivery-application-api</module>
        <module>modules/delivery/delivery-application</module>
        <module>modules/delivery/delivery-infrastructure</module>
        <module>modules/shipper/shipper-domain</module>
        <module>modules/shipper/shipper-application-api</module>
        <module>modules/shipper/shipper-application</module>
        <module>modules/shipper/shipper-infrastructure</module>
        <module>modules/match/match-domain</module>
        <module>modules/match/match-application-api</module>
        <module>modules/match/match-application</module>
        <module>modules/match/match-infrastructure</module>
        <module>modules/web-bff/web-bff-domain</module>
        <module>modules/web-bff/web-bff-application-api</module>
        <module>modules/web-bff/web-bff-application</module>
        <module>modules/web-bff/web-bff-infrastructure</module>
        <module>modules/auth/auth-domain</module>
        <module>modules/auth/auth-application-api</module>
        <module>modules/auth/auth-application</module>
        <module>modules/auth/auth-infrastructure</module>
        <module>auth-resource-server-starter</module>
        <module>discovery-server</module>
        <module>config-server</module>
        <module>auth-service</module>
        <module>user-service</module>
        <module>api-gateway</module>
        <module>web-bff-service</module>
        <module>delivery-service</module>
        <module>notification-service</module>
        <module>order-service</module>
        <module>restaurant-service</module>
        <module>shipper-service</module>
        <module>search-service</module>
        <module>saga-orchestrator-service</module>
        <module>tracking-service</module>
        <module>match-service</module>
        <module>routing</module>
        <module>livestream-service</module>
        <module>settlement-service</module>
        <module>flashsale-service</module>
        <module>analytics-service</module>
        <module>promotion-service</module>
        <module>simulator-service</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
